#!/bin/sh

set -eu

HOOK_DIR="$(CDPATH='' cd -- "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/git-hooks/common.sh
. "$HOOK_DIR/../scripts/git-hooks/common.sh"
REPO_ROOT="$(repo_root)"
cd "$REPO_ROOT"

remote_name="${1:-}"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/atlas-pre-push.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
paths_file="$tmp_dir/paths"
: >"$paths_file"
saw_ref=0

collect_push_paths() {
  : >"$tmp_dir/ref-paths"
  if ! is_zero_oid "$remote_oid"; then
    # The advertised remote endpoint matters even for divergent/forced updates.
    if ! remote_commit="$(git rev-parse --verify "$remote_oid^{commit}" 2>/dev/null)"; then
      return 1
    fi
    collect_changed_paths "$tmp_dir/ref-paths" "$remote_commit" "$local_commit"
    return
  fi

  # A new ref has no remote endpoint. Use only published ancestry known for
  # this destination remote, never HEAD~1 or an unrelated branch's upstream.
  [ -n "$remote_name" ] || return 1
  if ! git for-each-ref --format='%(objectname)' "refs/remotes/$remote_name/" >"$tmp_dir/remote-refs"; then
    return 1
  fi
  [ -s "$tmp_dir/remote-refs" ] || return 1
  if ! git rev-list --boundary "$local_commit" --not --remotes="$remote_name" >"$tmp_dir/history"; then
    return 1
  fi
  if [ ! -s "$tmp_dir/history" ]; then
    return 0
  fi
  boundary_count="$(awk '/^-/ { n++ } END { print n+0 }' "$tmp_dir/history")"
  [ "$boundary_count" -eq 1 ] || return 1
  baseline="$(sed -n 's/^-//p' "$tmp_dir/history")"
  collect_changed_paths "$tmp_dir/ref-paths" "$baseline" "$local_commit"
}

while IFS=' ' read -r local_ref local_oid remote_ref remote_oid extra || [ -n "$local_ref" ]; do
  [ -n "${local_ref:-}" ] || continue
  saw_ref=1
  if [ -z "$local_oid" ] || [ -z "$remote_ref" ] || [ -z "$remote_oid" ] || [ -n "$extra" ]; then
    echo "Cannot validate malformed pre-push ref input." >&2
    exit 1
  fi
  # Deleting a ref introduces no candidate to compile.
  if is_zero_oid "$local_oid"; then
    continue
  fi
  if ! local_commit="$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null)"; then
    echo "Cannot validate pushed object $local_oid as a code candidate." >&2
    exit 1
  fi
  if ! collect_push_paths; then
    echo "No reliable changed-path baseline for $remote_ref; requiring full checks." >&2
    printf '__atlas_unknown_push_baseline__\n' >"$tmp_dir/ref-paths"
  fi
  classify_validation_paths "$tmp_dir/ref-paths"
  if [ "$rust_touched" -eq 1 ] || [ "$web_touched" -eq 1 ]; then
    current_commit="$(git rev-parse --verify 'HEAD^{commit}')"
    if [ "$local_commit" != "$current_commit" ]; then
      echo "Cannot validate code at $local_ref from this checkout's HEAD." >&2
      echo "Push this ref from its own checkout; each code candidate needs its own gates." >&2
      exit 1
    fi
  fi
  cat "$tmp_dir/ref-paths" >>"$paths_file"
done

if [ "$saw_ref" -eq 0 ]; then
  echo "Running full pre-push checks without ref input..." >&2
  "$REPO_ROOT/scripts/verify-changed.sh" --all --full
else
  echo "Running path-sensitive full pre-push checks..." >&2
  "$REPO_ROOT/scripts/verify-changed.sh" --paths-file "$paths_file" --full
fi
