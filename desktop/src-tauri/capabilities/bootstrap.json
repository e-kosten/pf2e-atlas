{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap",
  "description": "Local Atlas launcher and setup window",
  "windows": ["bootstrap", "atlas-primary"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-inspect",
    "allow-launch",
    "allow-prepare",
    "allow-cancel-setup",
    "allow-enable-cli"
  ]
}
