  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
