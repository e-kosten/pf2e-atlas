{
  "name": "atlas-release-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test",
    "prenotices": "npm run build --silent",
    "notices": "node dist/src/cli/generate-notices.js",
    "premanifest": "npm run build --silent",
    "manifest": "node dist/src/cli/generate-release-manifest.js",
    "preprune": "npm run build --silent",
    "prune": "node dist/src/cli/prune-dist-manifest.js",
    "prevalidate": "npm run build --silent",
    "validate": "node dist/src/cli/validate-release-assets.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.13.10",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1"
  }
}
