{
  "name": "@pf2e-atlas/atlas-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "check:styles": "node scripts/check-raw-colors.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run routes:generate && vitest run",
    "typecheck": "npm run routes:generate && tsc -b --noEmit",
    "verify": "npm run check && vitest run && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:devices": "npm run build && playwright test --config playwright.devices.config.ts",
    "check": "npm run format:check && npm run lint && npm run check:styles && npm run typecheck",
    "routes:generate": "tsr generate",
    "verify:bundle": "npm run check && vite build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/lora": "^5.3.0",
    "@react-querybuilder/antd": "8.24.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.170.46",
    "antd": "^6.6.5",
    "dompurify": "3.4.17",
    "lucide-react": "^0.468.0",
    "lz-string": "1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-querybuilder": "8.24.1",
    "scroll-into-view-if-needed": "3.1.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.7",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "30.1.2",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "fsevents": false
  }
}
