{
  "name": "atlas-source-contracts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/*.test.js",
    "verify": "npm run typecheck && npm test",
    "preextract": "npm run build --silent",
    "extract": "node dist/extract.js",
    "pregenerate-equipment": "npm run build --silent",
    "generate-equipment": "node dist/generate-equipment.js",
    "presample-equipment": "npm run build --silent",
    "sample-equipment": "node dist/sample-equipment.js",
    "precompare-equipment": "npm run build --silent",
    "compare-equipment": "node dist/compare-equipment.js"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/jquery": "3.5.32",
    "@types/node": "22.13.10",
    "@types/tooltipster": "0.0.35",
    "remeda": "2.21.0"
  }
}
